"use client";

import { useMemo, useState } from "react";
import logoHeader from "../../workcerca-logo-header.png";

type CvData = {
  nombre: string;
  apellido: string;
  ciudad: string;
  telefono: string;
  email: string;
  objetivo: string;
  estudios: string;
  experiencia: string;
  habilidades: string;
  cursos: string;
  disponibilidad: string;
};

const initialCv: CvData = {
  nombre: "",
  apellido: "",
  ciudad: "",
  telefono: "",
  email: "",
  objetivo: "",
  estudios: "",
  experiencia: "",
  habilidades: "",
  cursos: "",
  disponibilidad: "",
};

const jobs = [
  ["Grupo Norte", "Auxiliar administrativo/a", "Reconquista", 92, "Presencial"],
  ["Comercial del Litoral", "Atención al cliente", "Avellaneda", 86, "Presencial"],
  ["Estudio Integral", "Asistente de oficina", "Remoto / Híbrido", 81, "Híbrido"],
];

const training = [
  ["Municipio", "Manipulación Segura de Alimentos", "Capacitación gratuita · Inscripción abierta"],
  ["Institución", "Herramientas digitales para el trabajo", "Curso corto · Modalidad mixta"],
  ["Feria Educativa", "Feria de carreras, cursos y oficios", "Carreras, cursos, becas y capacitaciones"],
];

export default function BuscoTrabajoPage() {
  const [mode, setMode] = useState<"start" | "create" | "upload">("start");
  const [step, setStep] = useState(1);
  const [notice, setNotice] = useState("");
  const [cv, setCv] = useState<CvData>(initialCv);

  const notify = (text: string) => {
    setNotice(text);
    window.setTimeout(() => setNotice(""), 2500);
  };

  const completeness = useMemo(() => {
    const values = Object.values(cv);
    return Math.round((values.filter((v) => v.trim()).length / values.length) * 100);
  }, [cv]);

  const update = (key: keyof CvData, value: string) =>
    setCv((prev) => ({ ...prev, [key]: value }));

  return (
    <main className="jobPage">
      {notice && <div className="jobToast">{notice}</div>}

      <aside className="jobSidebar">
        <button className="jobLogo" onClick={() => (window.location.href = "/")}>
          <img src={logoHeader.src} alt="WorkCerca" />
        </button>

        <div className="jobProfile">
          <div className="jobAvatar">MR</div>
          <div><strong>Mi perfil laboral</strong><span>WorkCerca</span></div>
        </div>

        <nav>
          <button onClick={() => (window.location.href = "/mi-workcerca")}>▣ Mi WorkCerca</button>
          <button onClick={() => (window.location.href = "/solicitudes")}>▤ Solicitudes</button>
          <button className="active">💼 Busco trabajo</button>
          <button onClick={() => notify("Mis postulaciones")}>📋 Mis postulaciones</button>
          <button onClick={() => notify("Mensajes")}>💬 Mensajes</button>
          <button onClick={() => notify("Entrevistas y videollamadas")}>📹 Videollamadas</button>
          <button onClick={() => notify("Agenda")}>📅 Agenda</button>
          <button onClick={() => notify("Feria de carreras, cursos y capacitaciones")}>🎓 Cursos y carreras</button>
          <button onClick={() => notify("Alertas inteligentes")}>🔔 Mis alertas</button>
        </nav>

        <div className="jobTrust">
          <b>WorkCerca Confianza</b>
          <p>
            Las verificaciones se muestran de forma clara. WorkCerca no inventa
            experiencia, títulos ni capacidades.
          </p>
        </div>
      </aside>

      <section className="jobMain">
        <header className="jobTop">
          <div>
            <strong>Busco trabajo / Mi CV</strong>
            <span>Creá tu perfil laboral y conectalo con oportunidades reales.</span>
          </div>
          <div className="jobTopActions">
            <button onClick={() => notify("Notificaciones")}>🔔</button>
            <button onClick={() => notify("Videollamadas")}>📹</button>
            <button onClick={() => notify("Mensajes")}>💬</button>
            <button className="outline" onClick={() => (window.location.href = "/mi-workcerca")}>
              Volver a Mi WorkCerca
            </button>
          </div>
        </header>

        <div className="jobContent">
          <section className="jobHero">
            <div>
              <span className="eyebrow">MI PRIMER EMPLEO · MI TRABAJO</span>
              <h1>Tu CV puede ser el comienzo de una oportunidad.</h1>
              <p>
                WorkCerca te ayuda a confeccionar un CV profesional, claro y creíble,
                y después conecta tu perfil con empleos, empresas, cursos, carreras,
                municipios e instituciones.
              </p>
            </div>

            <div className="jobSeal">
              <img src={logoHeader.src} alt="WorkCerca" />
              <strong>CV confeccionado con WorkCerca</strong>
              <span>Presentación profesional · Datos organizados · Verificación visible</span>
            </div>
          </section>

          {mode === "start" && (
            <>
              <section className="jobChoiceGrid">
                <button className="jobChoice primaryChoice" onClick={() => setMode("create")}>
                  <span>✦</span>
                  <div>
                    <small>RECOMENDADO</small>
                    <h2>Crear mi CV con WorkCerca</h2>
                    <p>
                      Te acompañamos paso a paso aunque sea tu primer empleo y todavía
                      no tengas experiencia.
                    </p>
                    <b>Empezar mi CV →</b>
                  </div>
                </button>

                <button className="jobChoice" onClick={() => setMode("upload")}>
                  <span>⬆</span>
                  <div>
                    <small>YA TENGO CV</small>
                    <h2>Subir mi CV</h2>
                    <p>
                      Cargá tu CV actual y completá tu perfil WorkCerca con la información
                      que falte.
                    </p>
                    <b>Subir archivo →</b>
                  </div>
                </button>
              </section>

              <section className="jobStandard">
                <span className="eyebrow dark">ESTÁNDAR WORKCERCA</span>
                <h2>¿Qué hace profesional a un CV WorkCerca?</h2>
                <div className="standardGrid">
                  <article><span>✓</span><h3>Información clara</h3><p>Ordenamos tu perfil para que una empresa pueda comprenderlo rápido.</p></article>
                  <article><span>🛡</span><h3>Verificación transparente</h3><p>Indicamos qué datos fueron verificados y cuáles fueron declarados.</p></article>
                  <article><span>✦</span><h3>Asistencia de IA</h3><p>La IA ayuda a redactar y ordenar, pero nunca inventa experiencia.</p></article>
                  <article><span>↗</span><h3>Conectado a oportunidades</h3><p>Tu CV alimenta recomendaciones de empleos, cursos y capacitaciones.</p></article>
                </div>
              </section>
            </>
          )}

          {mode === "create" && (
            <section className="cvBuilder">
              <div className="cvBuilderHead">
                <div>
                  <span className="eyebrow dark">CREAR MI CV CON WORKCERCA</span>
                  <h2>Vamos a construir tu perfil laboral paso a paso.</h2>
                  <p>
                    Completá lo que sepas. Si algo no aplica o todavía no tenés experiencia,
                    WorkCerca te ayuda a presentarlo correctamente.
                  </p>
                </div>
                <div className="cvProgress">
                  <strong>{completeness}%</strong>
                  <span>Perfil completo</span>
                  <div><i style={{ width: `${completeness}%` }} /></div>
                </div>
              </div>

              <div className="cvSteps">
                {[1, 2, 3, 4].map((n) => (
                  <button key={n} className={step === n ? "active" : ""} onClick={() => setStep(n)}>
                    {n === 1 && "1. Datos"}
                    {n === 2 && "2. Perfil"}
                    {n === 3 && "3. Formación"}
                    {n === 4 && "4. Experiencia"}
                  </button>
                ))}
              </div>

              <div className="cvBuilderGrid">
                <div className="cvForm">
                  {step === 1 && (
                    <div className="formGrid">
                      <label>Nombre<input value={cv.nombre} onChange={(e) => update("nombre", e.target.value)} placeholder="Tu nombre" /></label>
                      <label>Apellido<input value={cv.apellido} onChange={(e) => update("apellido", e.target.value)} placeholder="Tu apellido" /></label>
                      <label>Ciudad<input value={cv.ciudad} onChange={(e) => update("ciudad", e.target.value)} placeholder="Ciudad / localidad" /></label>
                      <label>Teléfono<input value={cv.telefono} onChange={(e) => update("telefono", e.target.value)} placeholder="WhatsApp o teléfono" /></label>
                      <label className="full">Correo<input value={cv.email} onChange={(e) => update("email", e.target.value)} placeholder="correo@ejemplo.com" /></label>
                    </div>
