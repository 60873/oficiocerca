                        <textarea value={cv.objetivo} onChange={(e) => update("objetivo", e.target.value)} placeholder="Ej.: Busco mi primera oportunidad en atención al cliente, administración o comercio." />
                      </label>
                      <label className="blockLabel">Habilidades y cosas que sabés hacer
                        <textarea value={cv.habilidades} onChange={(e) => update("habilidades", e.target.value)} placeholder="Atención al público, organización, manejo de PC, responsabilidad..." />
                      </label>
                      <label className="blockLabel">Disponibilidad
                        <input value={cv.disponibilidad} onChange={(e) => update("disponibilidad", e.target.value)} placeholder="Full time, part time, disponibilidad inmediata..." />
                      </label>
                      <button className="aiHelp" onClick={() => notify("La IA te ayudará a redactar sin inventar información.")}>✦ Ayudarme a redactar con IA</button>
                    </>
                  )}

                  {step === 3 && (
                    <>
                      <label className="blockLabel">Estudios
                        <textarea value={cv.estudios} onChange={(e) => update("estudios", e.target.value)} placeholder="Secundario, terciario, universidad, estudios en curso..." />
                      </label>
                      <label className="blockLabel">Cursos y capacitaciones
                        <textarea value={cv.cursos} onChange={(e) => update("cursos", e.target.value)} placeholder="Cursos, talleres, certificados, capacitaciones municipales..." />
                      </label>
                      <div className="cvHint">🎓 Los títulos, certificados o matrículas que WorkCerca verifique podrán mostrarse con una insignia específica.</div>
                    </>
                  )}

                  {step === 4 && (
                    <>
                      <label className="blockLabel">Experiencia laboral o experiencia útil
                        <textarea value={cv.experiencia} onChange={(e) => update("experiencia", e.target.value)} placeholder="Trabajos formales, changas, emprendimientos, ventas, cuidado de personas, voluntariados..." />
                      </label>
                      <div className="cvHint">💡 <b>¿Es tu primer empleo?</b> No inventamos experiencia. WorkCerca te ayuda a identificar habilidades reales que ya desarrollaste.</div>
                    </>
                  )}

                  <div className="formActions">
                    <button className="outline" onClick={() => setMode("start")}>Cancelar</button>
                    {step > 1 && <button className="outline" onClick={() => setStep(step - 1)}>← Anterior</button>}
                    {step < 4 ? (
                      <button className="primary" onClick={() => setStep(step + 1)}>Continuar →</button>
                    ) : (
                      <button className="primary" onClick={() => notify("CV guardado como borrador. Próximo paso: revisión y generación.")}>Guardar y revisar CV</button>
                    )}
                  </div>
                </div>

                <aside className="cvPreview">
                  <div className="cvPaper">
                    <div className="cvBrand"><img src={logoHeader.src} alt="WorkCerca" /><span>CV confeccionado con WorkCerca</span></div>
                    <h3>{cv.nombre || "Tu nombre"} {cv.apellido || "Tu apellido"}</h3>
                    <p className="cvGoal">{cv.objetivo || "Tu objetivo laboral aparecerá acá."}</p>
                    <div className="cvContact">
                      <span>⌖ {cv.ciudad || "Ciudad"}</span>
                      <span>✉ {cv.email || "correo@ejemplo.com"}</span>
                      <span>☎ {cv.telefono || "Teléfono"}</span>
                    </div>
                    <hr />
                    <h4>Perfil y habilidades</h4><p>{cv.habilidades || "Tus habilidades se mostrarán de forma clara y profesional."}</p>
                    <h4>Formación</h4><p>{cv.estudios || "Estudios y formación."}</p><p>{cv.cursos || "Cursos y capacitaciones."}</p>
                    <h4>Experiencia</h4><p>{cv.experiencia || "Experiencia laboral o experiencia útil."}</p>
                    <div className="cvVerification">
                      <b>Estado WorkCerca</b>
                      <span>○ Identidad: pendiente de verificación</span>
                      <span>○ Formación: pendiente de verificación</span>
                      <span>✓ CV estructurado con WorkCerca</span>
                    </div>
                    <small>WorkCerca organiza la información suministrada por la persona. Las verificaciones se identifican de forma independiente.</small>
                  </div>
                </aside>
              </div>
            </section>
          )}

          {mode === "upload" && (
            <section className="uploadCv">
              <span className="eyebrow dark">YA TENGO CV</span>
              <h2>Subí tu CV y completá tu perfil WorkCerca.</h2>
              <p>Podrás usar tu archivo actual y después revisar qué información conviene completar.</p>
              <label className="dropZone">
                <input type="file" accept=".pdf,.doc,.docx" onChange={() => notify("Archivo seleccionado. La lectura automática se conectará en la siguiente etapa.")} />
                <span>⬆</span><strong>Elegí tu CV</strong><small>PDF, DOC o DOCX</small>
              </label>
              <button className="outline" onClick={() => setMode("start")}>← Volver</button>
            </section>
          )}

          <section className="jobOpportunities">
            <div className="jobSectionTitle">
              <div><span className="eyebrow dark">MOTOR DE OPORTUNIDADES WORKCERCA</span><h2>Oportunidades que pueden servirte</h2></div>
              <button className="outline" onClick={() => notify("Ver todas las oportunidades")}>Ver todas</button>
            </div>
            <div className="jobGrid">
              {jobs.map(([company, title, location, match, mode]) => (
                <article key={String(title)}>
                  <span className="match">{match}% coincidencia</span>
                  <h3>{title}</h3><b>{company}</b>
                  <p>⌖ {location} · {mode}</p>
                  <small>WorkCerca explica por qué esta oportunidad puede coincidir con tu perfil.</small>
                  <div><button onClick={() => notify(`Ver detalle: ${title}`)}>Ver oportunidad</button><button onClick={() => notify(`Guardar: ${title}`)}>♡</button></div>
                </article>
              ))}
            </div>
          </section>

          <section className="trainingSection">
            <div className="jobSectionTitle">
              <div>
                <span className="eyebrow dark">FORMACIÓN QUE ABRE POSIBILIDADES</span>
                <h2>Feria de carreras, cursos y capacitaciones</h2>
                <p>Oportunidades ofrecidas por instituciones, municipios y otros actores del ecosistema WorkCerca.</p>
              </div>
            </div>
            <div className="trainingGrid">
              {training.map(([source, title, detail]) => (
                <article key={String(title)}>
                  <span>{source}</span><h3>{title}</h3><b>{detail}</b>
                  <p>Esta oportunidad puede ayudarte a mejorar o ampliar tu perfil laboral.</p>
                  <button onClick={() => notify(`Abrir: ${title}`)}>Ver información →</button>
                </article>
              ))}
            </div>
          </section>

          <section className="jobActionsBar">
            <button onClick={() => notify("Mis postulaciones")}>📋 Mis postulaciones</button>
            <button onClick={() => notify("Empresas interesadas")}>🏢 Empresas interesadas</button>
            <button onClick={() => notify("Mensajes")}>💬 Mensajes</button>
            <button onClick={() => notify("Videollamadas")}>📹 Entrevistas / Videollamadas</button>
            <button onClick={() => notify("Agenda")}>📅 Mi agenda</button>
            <button onClick={() => notify("Alertas inteligentes")}>🔔 Mis alertas</button>
          </section>
        </div>
      </section>

      <style jsx>{`
